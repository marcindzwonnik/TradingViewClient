<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- NuGet metadata shared by the packable libraries. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Marcin Dzwonnik</Authors>
    <Product>TradingView.Client</Product>
    <PackageTags>tradingview;trading;charts;pine-script;tradingview-cli;cdp</PackageTags>
    <PackageProjectUrl>https://github.com/marcindzwonnik/TradingViewClient</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marcindzwonnik/TradingViewClient.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- No license has been chosen for the repository yet; set PackageLicenseExpression (or a license file) before publishing. -->
    <NoWarn>$(NoWarn);NU5125</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
